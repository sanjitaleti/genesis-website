# Copy to .env.local and fill in your own values. Never commit .env.local.
#
# With these unset the portal runs on demo data and the demo login
# (Test123 / Test123). Setting them switches it to live data and real auth.

# --- Supabase -------------------------------------------------------------
# Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security, so it must never be prefixed
# NEXT_PUBLIC_ and never appear in client code.
SUPABASE_SERVICE_ROLE_KEY=

# --- ElevenLabs -----------------------------------------------------------
# Shown once when you create the post-call webhook. Used to verify the
# ElevenLabs-Signature header on every incoming call.
ELEVENLABS_WEBHOOK_SECRET=
