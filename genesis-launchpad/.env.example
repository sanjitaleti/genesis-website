# Copy to .env.local and fill in your own values. Never commit .env.local.
#
# With these unset the portal runs on demo data and the demo login
# (Test123 / Test123). Setting them switches it to live data and real auth.

# --- Supabase -------------------------------------------------------------
# Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security, so it must never be prefixed
# NEXT_PUBLIC_ and never appear in client code.
SUPABASE_SERVICE_ROLE_KEY=

# --- ElevenLabs -----------------------------------------------------------
# Shown once when you create the post-call webhook. Used to verify the
# ElevenLabs-Signature header on every incoming call.
ELEVENLABS_WEBHOOK_SECRET=

# Server-only. Used by /api/voices to list the verified voices shown in the
# configurator's voice picker (GET /v2/voices, filtered to
# voice_verification.is_verified). Only needs the "Voices: Read" scope —
# nothing else. Without this set, the picker falls back to a plain message
# instead of breaking.
ELEVENLABS_API_KEY=

# --- OpenRouter (Ask Genesis chat + configurator transcript draft) --------
# Server-only. Get a key at https://openrouter.ai/keys
# Powers BOTH:
#   /api/ai-dock             — the "Ask Genesis" assistant panel
#   /api/configurator/analyze — the personalized sample-call transcript
# Model: anthropic/claude-haiku-4.5 (~$1/M input, $5/M output).
# Without this set, the chat returns its fallback message and the
# configurator falls back to a generic illustrative transcript. Both fail
# quietly rather than erroring.
OPENROUTER_API_KEY=

# --- Resend (contact form + pricing intake emails) -------------------------
# Without these two set, form submissions still save to Supabase's `leads`
# table — they just don't also email anyone. See SETUP.md.
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=
# Optional. Defaults to Resend's shared sandbox sender, which works with zero
# setup. Switch to a verified genesislp.ai address once that's set up in Resend.
RESEND_FROM_EMAIL=

# --- Calendly (book-a-call step after the pricing intake form) ----------
# Public — embedded client-side. Leave unset and the intake success step
# falls back to plain "we'll reply within a business day" copy.
NEXT_PUBLIC_CALENDLY_URL=

# --- Admin (internal "mark customer as paid" page at /admin) ---------
# Pick any strong password. Unset means /admin is entirely unreachable.
ADMIN_PASSWORD=
